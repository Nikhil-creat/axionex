# Copy to .env — docker compose reads it automatically.
WEBHOOK_SECRET=replace-with-a-long-random-string
# Optional: enables LLM-written RAG answers (otherwise extractive answers are returned)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# "hash" avoids downloading the embedding model (useful offline)
EMBEDDING_BACKEND=sentence-transformers
CNN_BACKBONE=resnet50
# Path (inside the container) to fine-tuned multi-head weights
CNN_HEAD_CHECKPOINT=
